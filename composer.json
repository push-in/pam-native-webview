{
    "name": "pushinbr/pam-native-webview",
    "description": "Optional hardened native WebView for PAM Native.",
    "type": "pam-native-plugin",
    "license": "Apache-2.0",
    "keywords": [
        "pam",
        "pam-native",
        "php",
        "android",
        "ios",
        "webview"
    ],
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native": "^1.46"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\WebView\\": "src/"
        }
    },
    "extra": {
        "pam-native": {
            "plugin": "pam-native.plugin.json"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
